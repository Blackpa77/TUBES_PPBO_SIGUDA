{
    "name": "yourname/mvc-project",
    "description": "PHP MVC Project",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "controllers/",
            "App\\Models\\": "models/",
            "App\\Config\\": "config/"
        }
    },
    "config": {
        "platform-check": false,
        "optimize-autoloader": true
    }
}